# Configuração do Banco de Dados PostgreSQL
DATABASE_URL="postgresql://usuario:senha@localhost:5432/gerenciador_os"

# Porta do Servidor (opcional, padrão 3001)
PORT=3001

# Senhas Iniciais para Primeiro Deploy (opcional)
# JACIRA_INITIAL_PASSWORD=sua_senha_segura
# DEFAULT_INITIAL_PASSWORD=sua_senha_padrao

# Chave Mestra de Segurança para Redefinição/Esqueci Minha Senha (opcional, padrão stampex2026)
# ADMIN_RESET_KEY=uma_chave_mestra_secreta

